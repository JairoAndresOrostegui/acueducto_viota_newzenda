rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function currentUserData() {
      return get(currentUserPath()).data;
    }

    function isAdmin() {
      return signedIn() &&
          exists(currentUserPath()) &&
          currentUserData().rol == 'administrador' &&
          currentUserData().estado == 'activo';
    }

    function isOperador() {
      return signedIn() &&
          exists(currentUserPath()) &&
          currentUserData().rol == 'operador' &&
          currentUserData().estado == 'activo';
    }

    function isContador() {
      return signedIn() &&
          exists(currentUserPath()) &&
          currentUserData().rol in ['contador', 'fiscal'] &&
          currentUserData().estado == 'activo';
    }

    function isTesorero() {
      return signedIn() &&
          exists(currentUserPath()) &&
          currentUserData().rol == 'tesorero' &&
          currentUserData().estado == 'activo';
    }

    function isActiveClientDoc() {
      return resource.data.rol == 'cliente' &&
          resource.data.estado == 'activo';
    }

    function canManageConsumptions() {
      return isAdmin() || isOperador();
    }

    function canViewConsumptionReports() {
      return isAdmin() || isContador() || isTesorero();
    }

    function isOwnClientCode(code) {
      return signedIn() &&
          exists(currentUserPath()) &&
          currentUserData().rol == 'cliente' &&
          currentUserData().estado == 'activo' &&
          (currentUserData().codigoUsuario == code ||
              (currentUserData().keys().hasAny(['codigosUsuarioValores']) &&
                  code in currentUserData().codigosUsuarioValores));
    }

    function isPaymentStatusUpdate() {
      return isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'pagado',
                'estado',
                'reciboId',
                'valorPagado',
                'fechaPago',
                'medioPagoId',
                'medioPagoDescripcion',
                'observacionesPago'
              ]);
    }

    function isAdministrativeInvoiceStatusUpdate() {
      return isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'pagado',
                'facturado',
                'estado',
                'reciboId',
                'detalleEstado',
                'observacionesAdmin'
              ]) &&
          request.resource.data.estado in ['facturado', 'pagado', 'suspendido'] &&
          request.resource.data.facturado == true;
    }

    match /usuarios/{userId} {
      allow read: if signedIn() &&
          (request.auth.uid == userId ||
              isAdmin() ||
              (isOperador() && isActiveClientDoc()) ||
              ((isContador() || isTesorero()) && isActiveClientDoc()));

      // User mutations must go through the validated Cloud Functions. The
      // Admin SDK bypasses these rules, while direct clients cannot change
      // roles, superAdmin, status, or skip the audit trail.
      allow create, update, delete: if false;
    }

    match /tipos_documento/{docId} {
      allow read: if signedIn() &&
          (isAdmin() || resource.data.estado == 'activo');
      allow create, update, delete: if isAdmin();
    }

    match /roles/{docId} {
      allow read: if signedIn() &&
          (isAdmin() || resource.data.estado == 'activo');
      allow create, update, delete: if isAdmin();
    }

    match /sectores/{docId} {
      allow read: if signedIn() &&
          (isAdmin() || resource.data.estado == 'activo');
      allow create, update, delete: if isAdmin();
    }

    match /usuarios_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /periodos/{periodoId} {
      allow read: if canManageConsumptions() || canViewConsumptionReports();
      allow create, update: if isAdmin();
      allow delete: if false;

      match /consumos/{consumoId} {
        allow read: if canManageConsumptions() || canViewConsumptionReports();
        allow create: if canManageConsumptions();
        allow update: if canManageConsumptions() &&
            (!(resource.data.facturado == true || resource.data.pagado == true) ||
                isPaymentStatusUpdate() ||
                isAdministrativeInvoiceStatusUpdate());
        allow delete: if false;

        match /historial/{historialId} {
          allow read: if isAdmin();
          allow create, update: if canManageConsumptions();
          allow delete: if false;
        }
      }

      match /recibos/{reciboId} {
        allow read: if isAdmin() ||
            isContador() ||
            isTesorero() ||
            isOwnClientCode(resource.data.codigoUsuario);
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    match /{path=**}/recibos/{reciboId} {
      allow read: if isAdmin() ||
          isContador() ||
          isTesorero() ||
          isOwnClientCode(resource.data.codigoUsuario);
      allow create, update, delete: if false;
    }

    match /{path=**}/consumos/{consumoId} {
      allow read: if canManageConsumptions() || canViewConsumptionReports();
      allow create, update, delete: if false;
    }

    match /medios_pago/{medioPagoId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /gastos_conceptos/{conceptoId} {
      allow read: if isAdmin() ||
          (isTesorero() && resource.data.estado == 'activo');
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /gastos/{gastoId} {
      allow read: if isAdmin() || isTesorero() || isContador();
      allow create: if isAdmin() || isTesorero();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /gastos_soportes/{periodoId} {
      allow read: if isAdmin() || isTesorero();
      allow create: if isAdmin() || isTesorero();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /facturacion_observaciones/{observacionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /valores_facturacion/{valorId} {
      allow read: if canViewConsumptionReports();
      allow create, update, delete: if isAdmin();
    }

    match /cuentas_movimientos/{movimientoId} {
      allow read: if isAdmin() || isContador() || isTesorero();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /consumos_conflictos/{conflictoId} {
      allow create: if canManageConsumptions();
      allow read: if isAdmin() ||
          (isOperador() && resource.data.actorUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
